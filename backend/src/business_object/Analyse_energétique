import ast
from .fichier import Fichier


class Analyse_énergétique:
    def __init__(self, fichier_cible: Fichier) -> None:
        self.fichier_cible = fichier_cible
        self.AST_analyse: ast.AST | None = None
        self.consommation_estimee_kWh: float | None = None
        self.emissionCO2: float | None = None

    def analyser_complexite_code(self, fichier: Fichier) -> str:
        """Analyse la complexité du code Python du fichier."""
        
        if fichier.extension != ".py":
            raise ValueError("Le fichier doit être un fichier Python.")

        with open(fichier.chemin, "r", encoding="utf-8") as f:
            contenu = f.read()

        self.AST_analyse = ast.parse(contenu)

        # Score simple basé sur les structures de contrôle
        complexite = 1

        for node in ast.walk(self.AST_analyse):
            if isinstance(node, (ast.For, ast.While)):
                complexite += 2
            elif isinstance(node, ast.If):
                complexite += 1
            elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                complexite += 1

        # On conserve la complexité dans le fichier
        fichier.complexite = str(complexite)

        return str(complexite)

    def detecter_anti_pattern(self, ast_analyse: ast.AST) -> list:
        """Détecte les principaux anti-patterns énergétiques."""

        anti_patterns = []

        # Détection des boucles imbriquées
        for node in ast.walk(ast_analyse):
            if isinstance(node, (ast.For, ast.While)):

                for enfant in ast.walk(node):
                    if enfant is not node and isinstance(
                        enfant, (ast.For, ast.While)
                    ):
                        anti_patterns.append("Boucle imbriquée")
                        break

        # Détection de la récursion
        for node in ast.walk(ast_analyse):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):

                for appel in ast.walk(node):
                    if (
                        isinstance(appel, ast.Call)
                        and isinstance(appel.func, ast.Name)
                        and appel.func.id == node.name
                    ):
                        anti_patterns.append(
                            f"Récursion dans la fonction {node.name}"
                        )
                        break

        return anti_patterns

    def calculer_consommation(self) -> float:
        """Estime la consommation énergétique du fichier."""

        if self.AST_analyse is None:
            self.analyser_complexite_code(self.fichier_cible)

        complexite = int(self.fichier_cible.complexite)

        anti_patterns = self.detecter_anti_pattern(self.AST_analyse)

        # Estimation simplifiée de la consommation.
        # Cette valeur pourra être affinée avec les mesures
        # de la machine de référence.
        puissance_machine_w = 100

        temps_execution_h = (
            complexite * 0.000001
            + len(anti_patterns) * 0.000001
        )

        self.consommation_estimee_kWh = (
            puissance_machine_w / 1000
        ) * temps_execution_h

        return self.consommation_estimee_kWh

    def calculer_emissionCO2(self) -> float:
        """Calcule les émissions de CO2 à partir de la consommation."""

        if self.consommation_estimee_kWh is None:
            self.calculer_consommation()

        # Facteur d'émission utilisé pour l'estimation
        facteur_carbone = 50  # gCO2e / kWh

        self.emissionCO2 = (
            self.consommation_estimee_kWh * facteur_carbone
        )

        self.fichier_cible.emissionCO2 = self.emissionCO2

        return self.emissionCO2